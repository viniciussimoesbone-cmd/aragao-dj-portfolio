# Pooled (pgbouncer, porta 6543) — usada em runtime pela aplicação.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direta (porta 5432) — usada só para migrations (prisma migrate).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres"
